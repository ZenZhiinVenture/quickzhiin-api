# Environment Variables

# Database (PostgreSQL Connection URL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=core

# TENANT Database related
# Use Case : when database server got over 50 database in one server, 
# need to create new instance in Google Cloud SQL and update the variable 
# 
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=password
TENANT_DB_PREFIX=tenant

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET="LOCAL_SECRET" # Change this to a strong, random secret
JWT_EXPIRES_IN=1 # Example: 1 day expiration
JWT_REFRESH_EXPIRES_IN=7 # Example: 7 days expiration

# Encryption Configuration
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE
ENCRYPTION_ALGORITHM=aes-256-cbc

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com

# Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_MULTI_TENANCY=true
ENABLE_AUDIT_LOGS=true
ENABLE_RATE_LIMITING=true

# Important: Create a .env file by copying this and fill in your actual database credentials and a strong JWT_SECRET. Do not commit your .env file to version control.