  purchaseReqUpdated    PurchaseRequisition[] @relation("PurchaseReqUpdatedBy")
  purchaseOrderCreated  PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  purchaseOrderUpdated  PurchaseOrder[]       @relation("PurchaseOrderUpdatedBy")
  goodsReceivedCreated  GoodsReceivedNote[]   @relation("GoodsReceivedCreatedBy")
  goodsReceivedUpdated  GoodsReceivedNote[]   @relation("GoodsReceivedUpdatedBy")
  warehouseCreated      Warehouse[]           @relation("WarehouseCreatedBy")
  warehouseUpdated      Warehouse[]           @relation("WarehouseUpdatedBy")

  bankStatementsCreated             BankStatement[]              @relation("BankStatementCreatedBy")
  bankStatementsUpdated             BankStatement[]              @relation("BankStatementUpdatedBy")
  bankTransactionLineMatchedCreated BankTransactionLineMatched[] @relation("BankTransactionLineMatchedCreatedBy")

  @@map("users")
}

// --- Sales & Purchase Models ---

model SalesQuote {
  id              BigInt                @id @default(autoincrement())
  number          String                @unique
  date            DateTime
  expiryDate      DateTime?             @map("expiry_date")
  contactId       BigInt                @map("contact_id")
  currency        String
  subtotal        Decimal
  tax             Decimal               @default(0)
  discount        Decimal               @default(0)
  total           Decimal
  status          TransactionStatusType @default(DRAFT)
  notes           String?
  terms           String?
  billingAddress  String?
  shippingAddress String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  contact       Contact          @relation("SalesQuoteContact", fields: [contactId], references: [id])
  quoteLines    SalesQuoteLine[]
  createdByUser User?            @relation("SalesQuoteCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?            @relation("SalesQuoteUpdatedBy", fields: [updatedBy], references: [id])

  @@map("sales_quotes")
}

model SalesQuoteLine {
  id                 BigInt  @id @default(autoincrement())
  salesQuoteId       BigInt
  productId          BigInt?
  productName        String
  description        String?
  classificationCode String?
  msicCode           String?
  msicDescription    String?
  quantity           Decimal @db.Decimal(19, 4)
  unitPrice          Decimal @map("unitPrice") @db.Decimal(19, 4)
  discount           Decimal @default(0)
  tax                Decimal @default(0)
  total              Decimal

  salesQuote SalesQuote @relation(fields: [salesQuoteId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])

  @@map("sales_quote_lines")
}

model SalesOrder {
  id              BigInt                @id @default(autoincrement())
  number          String                @unique
  date            DateTime
  expectedDate    DateTime?             @map("expected_date")
  contactId       BigInt                @map("contact_id")
  currency        String
  subtotal        Decimal
  tax             Decimal               @default(0)
  discount        Decimal               @default(0)
  total           Decimal
  status          TransactionStatusType @default(DRAFT)
  notes           String?
  terms           String?
  billingAddress  String?
  shippingAddress String?
  quoteId         BigInt?               @unique

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  contact        Contact          @relation("SalesOrderContact", fields: [contactId], references: [id])
  orderLines     SalesOrderLine[]
  deliveryOrders DeliveryOrder[]
  createdByUser  User?            @relation("SalesOrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?            @relation("SalesOrderUpdatedBy", fields: [updatedBy], references: [id])

  @@map("sales_orders")
}

model SalesOrderLine {
  id                 BigInt  @id @default(autoincrement())
  salesOrderId       BigInt
  productId          BigInt?
  productName        String
  description        String?
  classificationCode String?
  msicCode           String?
  msicDescription    String?
  quantity           Decimal @db.Decimal(19, 4)
  deliveredQuantity  Decimal @default(0) @map("delivered_quantity") @db.Decimal(19, 4)
  unitPrice          Decimal @map("unitPrice") @db.Decimal(19, 4)
  discount           Decimal @default(0)
  tax                Decimal @default(0)
  total              Decimal

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])

  @@map("sales_order_lines")
}

model DeliveryOrder {
  id              BigInt                @id @default(autoincrement())
  number          String                @unique
  date            DateTime
  salesOrderId    BigInt?
  contactId       BigInt                @map("contact_id")
  carrier         String?
  trackingNumber  String?               @map("tracking_number")
  status          TransactionStatusType @default(DRAFT)
  notes           String?
  shippingAddress String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  salesOrder     SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  contact        Contact             @relation("DeliveryOrderContact", fields: [contactId], references: [id])
  deliveryLines  DeliveryOrderLine[]
  stockMovements StockMovement[]
  createdByUser  User?               @relation("DeliveryOrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?               @relation("DeliveryOrderUpdatedBy", fields: [updatedBy], references: [id])

  @@map("delivery_orders")
}

model DeliveryOrderLine {
  id               BigInt  @id @default(autoincrement())
  deliveryOrderId  BigInt
  salesOrderLineId BigInt?
  productId        BigInt
  productName      String
  quantity         Decimal @db.Decimal(19, 4)
  warehouseId      BigInt?

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  warehouse     Warehouse?    @relation(fields: [warehouseId], references: [id])

  @@map("delivery_order_lines")
}

model PurchaseRequisition {
  id           BigInt                @id @default(autoincrement())
  number       String                @unique
  date         DateTime
  priority     String                @default("MEDIUM")
  departmentId BigInt?
  status       TransactionStatusType @default(DRAFT)
  notes        String?
  requestedBy  BigInt

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  requester      User                      @relation("PurchaseRequester", fields: [requestedBy], references: [id])
  department     Department?               @relation(fields: [departmentId], references: [id])
  reqLines       PurchaseRequisitionLine[]
  purchaseOrders PurchaseOrder[]
  createdByUser  User?                     @relation("PurchaseReqCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?                     @relation("PurchaseReqUpdatedBy", fields: [updatedBy], references: [id])

  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id                    BigInt  @id @default(autoincrement())
  purchaseRequisitionId BigInt
  productId             BigInt?
  productName           String
  description           String?
  quantity              Decimal @db.Decimal(19, 4)
  estimatedUnitPrice    Decimal @default(0) @map("estimated_unitPrice") @db.Decimal(19, 4)

  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
  product             Product?            @relation(fields: [productId], references: [id])

  @@map("purchase_requisition_lines")
}

model PurchaseOrder {
  id            BigInt                @id @default(autoincrement())
  number        String                @unique
  date          DateTime
  expectedDate  DateTime?             @map("expected_date")
  contactId     BigInt                @map("contact_id")
  currency      String
  subtotal      Decimal
  tax           Decimal               @default(0)
  discount      Decimal               @default(0)
  total         Decimal
  status        TransactionStatusType @default(DRAFT)
  notes         String?
  terms         String?
  requisitionId BigInt?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  contact       Contact              @relation("PurchaseOrderContact", fields: [contactId], references: [id])
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  orderLines    PurchaseOrderLine[]
  receipts      GoodsReceivedNote[]
  createdByUser User?                @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?                @relation("PurchaseOrderUpdatedBy", fields: [updatedBy], references: [id])

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               BigInt  @id @default(autoincrement())
  purchaseOrderId  BigInt
  productId        BigInt?
  productName      String
  description      String?
  quantity         Decimal @db.Decimal(19, 4)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(19, 4)
  unitPrice        Decimal @map("unitPrice") @db.Decimal(19, 4)
  discount         Decimal @default(0)
  tax              Decimal @default(0)
  total            Decimal

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product?      @relation(fields: [productId], references: [id])

  @@map("purchase_order_lines")
}

model GoodsReceivedNote {
  id              BigInt                @id @default(autoincrement())
  number          String                @unique
  date            DateTime
  purchaseOrderId BigInt?
  contactId       BigInt                @map("contact_id")
  status          TransactionStatusType @default(DRAFT)
  notes           String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  purchaseOrder  PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  contact        Contact                 @relation("GoodsReceivedContact", fields: [contactId], references: [id])
  receiptLines   GoodsReceivedNoteLine[]
  stockMovements StockMovement[]
  createdByUser  User?                   @relation("GoodsReceivedCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?                   @relation("GoodsReceivedUpdatedBy", fields: [updatedBy], references: [id])

  @@map("goods_received_notes")
}

model GoodsReceivedNoteLine {
  id                  BigInt  @id @default(autoincrement())
  grnId               BigInt
  purchaseOrderLineId BigInt?
  productId           BigInt
  productName         String
  quantity            Decimal @db.Decimal(19, 4)
  warehouseId         BigInt?

  goodsReceivedNote GoodsReceivedNote @relation(fields: [grnId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  warehouse         Warehouse?        @relation(fields: [warehouseId], references: [id])

  @@map("goods_received_note_lines")
}

// --- Inventory & Logistics Models ---

model Warehouse {
  id          BigInt  @id @default(autoincrement())
  name        String
  code        String  @unique
  location    String?
  description String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  inventory          WarehouseInventory[]
  stockMovementsFrom StockMovement[]         @relation("FromWarehouse")
  stockMovementsTo   StockMovement[]         @relation("ToWarehouse")
  deliveryOrderLines DeliveryOrderLine[]
  grnLines           GoodsReceivedNoteLine[]
  createdByUser      User?                   @relation("WarehouseCreatedBy", fields: [createdBy], references: [id])
  updatedByUser      User?                   @relation("WarehouseUpdatedBy", fields: [updatedBy], references: [id])

  @@map("warehouses")
}

model WarehouseInventory {
  id          BigInt  @id @default(autoincrement())
  warehouseId BigInt
  productId   BigInt
  quantity    Decimal @default(0) @db.Decimal(19, 4)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("warehouse_inventory")
}

model StockMovement {
  id              BigInt          @id @default(autoincrement())
  productId       BigInt
  fromWarehouseId BigInt?
  toWarehouseId   BigInt?
  type            TransactionType
  quantity        Decimal         @db.Decimal(19, 4)
  date            DateTime        @default(now())
  referenceId     BigInt?
  notes           String?

  product       Product            @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse?         @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?         @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  deliveryOrder DeliveryOrder?     @relation(fields: [referenceId], references: [id], map: "stock_movement_delivery_order_fk")
  grn           GoodsReceivedNote? @relation(fields: [referenceId], references: [id], map: "stock_movement_grn_fk")

  @@map("stock_movements")
}
