generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum AuditType {
  SYSTEM
  USER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum AuditChannel {
  WEB
  API
  MOBILE
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

enum DepreciationMode {
  FIXED
  PERCENTAGE
}

enum DepreciationConvention {
  FULL_MONTH
  HALF_YEAR
  MID_MONTH
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  OTHER_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  OTHER_LIABILITY
  RETAINED_EARNINGS
  OWNER_EQUITY
  OTHER_EQUITY
  SALES
  SERVICE_REVENUE
  OTHER_REVENUE
  OPERATING_EXPENSE
  COST_OF_GOODS_SOLD
  DEPRECIATION
  OTHER_EXPENSE
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE
  INTEREST
  ADJUSTMENT
}

enum BankTransactionStatus {
  PENDING
  CLEARED
  RECONCILED
}

enum ContactType {
  COMPANY
  BRANCH
  EMPLOYEE
  CUSTOMER
  SUPPLIER
}

enum RegistrationNumberType {
  NONE
  BRN
  IC
  PASSPORT
}

enum ReconciliationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  NONE
  LINK
  TEXT
  TABLE
}

enum SettingType {
  NUMBER
  BOOLEAN
  STRING
  ARRAY
}

enum StateType {
  NONE
  STATE
  PROVINCE
  REGION
  DIVISION
}

enum TransactionType {
  ASSET_DEPRECIATE
  ASSET_DISPOSE
  BANK_ADJUSTMENT
  BANK_EXPENSE
  BANK_INCOME
  BANK_TRANSFER
  CONTRA
  PURCHASE_BILL
  PURCHASE_CREDIT_NOTE
  PURCHASE_GOOD_RECEIVE
  PURCHASE_ORDER
  PURCHASE_PAYMENT
  PURCHASE_QUOTATION
  PURCHASE_REFUND
  SALE_CREDIT_NOTE
  SALE_DELIVERY_ORDER
  SALE_INVOICE
  SALE_ORDER
  SALE_PAYMENT
  SALE_QUOTATION
  SALE_REFUND
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  STOCK_VALUE
}

enum TransactionStatusType {
  DRAFT
  PENDING
  READY
  PAID
}

// --- Models ---

model Account {
  id          BigInt          @id @default(autoincrement())
  code        String          @unique
  name        String
  type        AccountType
  subtype     AccountSubType?
  description String?

  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  createdByUser     User?              @relation("AccountCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?              @relation("AccountUpdatedBy", fields: [updatedBy], references: [id])
  journalEntryLines JournalEntryLine[]
  paymentMethods    PaymentMethod[]
  bankAccount       BankAccount?

  @@map("accounts")
}

model Asset {
  id          BigInt @id @default(autoincrement())
  name        String
  assetTag    String @unique
  assetTypeId Int

  assetAccountId        Int
  depreciationAccountId Int
  expenseAccountId      Int

  defaultMethod     DepreciationMethod
  defaultConvention DepreciationConvention
  defaultMode       DepreciationMode
  defaultRate       Float
  defaultYear       Int
  defaultMonth      Int

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  createdByUser User?     @relation("AssetCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?     @relation("AssetUpdatedBy", fields: [updatedBy], references: [id])
  assetType     AssetType @relation(fields: [assetTypeId], references: [id])

  @@map("assets")
}

model AssetType {
  id            Int                @id @default(autoincrement())
  name          String             @unique
  description   String?
  defaultMethod DepreciationMethod
  defaultRate   Float
  defaultMode   DepreciationMode
  defaultYears  Int?
  defaultMonths Int?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  createdByUser User?   @relation("AssetTypeCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?   @relation("AssetTypeUpdatedBy", fields: [updatedBy], references: [id])
  assets        Asset[]

  @@map("asset_types")
}

model AuditContact {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  contactId BigInt
  action    String
  oldData   String
  newData   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  createdByUser User? @relation("AuditContactCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("AuditContactUpdatedBy", fields: [updatedBy], references: [id])

  @@map("audit_contacts")
}

model AuditTrail {
  id        BigInt       @id @default(autoincrement())
  userId    BigInt
  tableName String       @map("table_name")
  type      AuditType
  action    AuditAction
  channel   AuditChannel
  source    String?
  oldData   Json?
  newData   Json?
  createdAt DateTime     @default(now())

  user User @relation("UserAudit", fields: [userId], references: [id])

  @@map("audit_trails")
}

model BankAccount {
  id            BigInt  @id @default(autoincrement())
  name          String
  bankName      String
  accountNumber String
  currency      String
  balance       Decimal @default(0)
  accountId     BigInt? @unique

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  account         Account?             @relation(fields: [accountId], references: [id])
  createdByUser   User?                @relation("BankAccountCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?                @relation("BankAccountUpdatedBy", fields: [updatedBy], references: [id])
  transactions    BankTransaction[]
  reconciliations BankReconciliation[]
  bankStatements  BankStatement[]

  @@map("bank_accounts")
}

model BankStatement {
  id             BigInt   @id @default(autoincrement())
  bankAccountId  BigInt
  fileName       String   @map("file_name")
  fileUrl        String?  @map("file_url")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  openingBalance Decimal  @default(0) @map("opening_balance")
  closingBalance Decimal  @default(0) @map("closing_balance")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  bankAccount   BankAccount       @relation(fields: [bankAccountId], references: [id])
  transactions  BankTransaction[]
  createdByUser User?             @relation("BankStatementCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?             @relation("BankStatementUpdatedBy", fields: [updatedBy], references: [id])

  @@map("bank_statements")
}

model BankReconciliation {
  id                BigInt               @id @default(autoincrement())
  bankAccountId     BigInt
  periodStart       DateTime
  periodEnd         DateTime
  statementBalance  Decimal
  reconciledBalance Decimal
  status            ReconciliationStatus @default(DRAFT)
  notes             String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  bankAccount   BankAccount       @relation(fields: [bankAccountId], references: [id])
  transactions  BankTransaction[]
  createdByUser User?             @relation("BankReconciliationCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?             @relation("BankReconciliationUpdatedBy", fields: [updatedBy], references: [id])

  @@map("bank_reconciliations")
}

model BankTransaction {
  id               BigInt                @id @default(autoincrement())
  bankAccountId    BigInt
  bankStatementId  BigInt?
  date             DateTime
  type             BankTransactionType
  amount           Decimal
  description      String?
  reference        String?
  status           BankTransactionStatus @default(PENDING)
  reconciliationId BigInt?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  bankAccount    BankAccount                  @relation(fields: [bankAccountId], references: [id])
  bankStatement  BankStatement?               @relation(fields: [bankStatementId], references: [id])
  reconciliation BankReconciliation?          @relation(fields: [reconciliationId], references: [id])
  createdByUser  User?                        @relation("BankTransactionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?                        @relation("BankTransactionUpdatedBy", fields: [updatedBy], references: [id])
  matchedLines   BankTransactionLineMatched[]

  @@map("bank_transactions")
}

model BankTransactionLineMatched {
  id                 BigInt  @id @default(autoincrement())
  bankTransactionId  BigInt  @map("bank_transaction_id")
  journalEntryLineId BigInt  @map("journal_entry_line_id")
  amount             Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy BigInt?  @map("created_by")

  bankTransaction  BankTransaction  @relation(fields: [bankTransactionId], references: [id])
  journalEntryLine JournalEntryLine @relation(fields: [journalEntryLineId], references: [id])
  createdByUser    User?            @relation("BankTransactionLineMatchedCreatedBy", fields: [createdBy], references: [id])

  @@map("bank_transaction_line_matched")
}

model Bill {
  id              BigInt                @id @default(autoincrement())
  number          String                @unique
  date            DateTime
  contactId       BigInt                @map("contact_id")
  subtotal        Decimal
  tax             Decimal               @default(0)
  discount        Decimal               @default(0)
  rounding        Decimal               @default(0)
  total           Decimal
  status          TransactionStatusType @default(DRAFT)
  notes           String?
  billingAddress  String?
  shippingAddress String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  contact        Contact         @relation("BillContact", fields: [contactId], references: [id])
  billLines      BillLine[]
  payments       BillPayment[]
  refunds        BillRefund[]
  billCreditNote BillCreditNote?
  createdByUser  User?           @relation("BillCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?           @relation("BillUpdatedBy", fields: [updatedBy], references: [id])

  @@map("bills")
}

model BillCreditNote {
  id         BigInt                @id @default(autoincrement())
  number     String                @unique
  date       DateTime
  billId     BigInt?               @unique
  contactId  BigInt                @map("contact_id")
  amount     Decimal
  reason     String
  status     TransactionStatusType @default(DRAFT)
  currency   String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  bill            Bill?                @relation(fields: [billId], references: [id])
  contact         Contact              @relation("BillCreditNoteContact", fields: [contactId], references: [id])
  creditNoteLines BillCreditNoteLine[]
  createdByUser   User?                @relation("BillCreditNoteCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?                @relation("BillCreditNoteUpdatedBy", fields: [updatedBy], references: [id])

  @@map("bill_credit_notes")
}

model BillCreditNoteLine {
  id                 BigInt  @id @default(autoincrement())
  billCreditNoteId   BigInt  @unique
  productName        String
  description        String
  classificationCode String
  quantity           BigInt
  unitPrice         Decimal
  discount           Decimal
  tax                Decimal
  total              Decimal
  taxId              BigInt? @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  billCreditNote BillCreditNote @relation(fields: [billCreditNoteId], references: [id])
  taxCode        TaxCode?       @relation("TaxCodeBillCreditNoteLine", fields: [taxId], references: [id], map: "tax_code_bill_credit_note_line_fk")
  createdByUser  User?          @relation("BillCreditNoteLineCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?          @relation("BillCreditNoteLineUpdatedBy", fields: [updatedBy], references: [id])

  @@map("bill_credit_note_lines")
}

model BillLine {
  id                 BigInt  @id @default(autoincrement())
  billId             BigInt  @unique
  productName        String
  description        String
  classificationCode String
  quantity           BigInt
  unitPrice         Decimal
  discount           Decimal
  tax                Decimal
  total              Decimal
  taxId              BigInt? @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  bill          Bill     @relation(fields: [billId], references: [id])
  taxCode       TaxCode? @relation("TaxCodeBillLine", fields: [taxId], references: [id], map: "tax_code_bill_line_fk")
  createdByUser User?    @relation("BillLineCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("BillLineUpdatedBy", fields: [updatedBy], references: [id])

  @@map("bill_lines")
}

model BillPayment {
  id       BigInt   @id @default(autoincrement())
  billId   BigInt   @unique
  amount   Decimal
  methodId BigInt   @unique
  paidAt   DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  bill          Bill          @relation(fields: [billId], references: [id])
  method        PaymentMethod @relation(fields: [methodId], references: [id])
  createdByUser User?         @relation("BillPaymentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?         @relation("BillPaymentUpdatedBy", fields: [updatedBy], references: [id])

  @@map("bill_payments")
}

model BillRefund {
  id         BigInt   @id @default(autoincrement())
  billId     BigInt   @unique
  amount     Decimal
  reason     String
  methodId   BigInt   @unique
  refundedAt DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  bill          Bill          @relation(fields: [billId], references: [id])
  method        PaymentMethod @relation(fields: [methodId], references: [id])
  createdByUser User?         @relation("BillRefundCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?         @relation("BillRefundUpdatedBy", fields: [updatedBy], references: [id])

  @@map("bill_refunds")
}

model BusinessCode {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique
  name        String
  reference   String?
  description String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  createdByUser User? @relation("BusinessCodeCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("BusinessCodeUpdatedBy", fields: [updatedBy], references: [id])

  @@map("business_codes")
}

model ClassficationCode {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique
  description String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  createdByUser User? @relation("ClassficationCodeCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("ClassficationCodeUpdatedBy", fields: [updatedBy], references: [id])

  @@map("classification_codes")
}

model Contact {
  id                          BigInt                  @id @default(autoincrement())
  parentId                    BigInt?                 @map("parent_id")
  legalname                   String
  contactType                 ContactType
  regNoType                   RegistrationNumberType?
  regNo                       String?
  taxNo                       String?
  pfNo                        String?
  businessCodeId              String?
  website                     String?
  logoUrl                     String?
  position                    String?
  joinDate                    DateTime?
  userId                      BigInt?
  departmentId                Int?
  defaultCountryId            Int?
  accountsReceivableAccountId BigInt?
  accountsPayableAccountId    BigInt?
  creditLimit                 Decimal                 @default(0) @db.Decimal(15, 2)
  paymentTerms                Int                     @default(0)
  sstNo                       String?                 @map("sst_no")
  msicCode                    String?                 @map("msic_code")
  isCustomer                  Boolean                 @default(false) @map("is_customer")
  isSupplier                  Boolean                 @default(false) @map("is_supplier")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  parent           Contact?         @relation("ContactParent", fields: [parentId], references: [id])
  children         Contact[]        @relation("ContactParent")
  user             User?            @relation("ContactUser", fields: [userId], references: [id])
  createdByUser    User?            @relation("ContactCreatedBy", fields: [createdBy], references: [id])
  updatedByUser    User?            @relation("ContactUpdatedBy", fields: [updatedBy], references: [id])
  contactAddresses ContactAddress[]
  contact_persons  ContactPerson[]
  salesQuotes      SalesQuote[]        @relation("SalesQuoteContact")
  salesOrders      SalesOrder[]        @relation("SalesOrderContact")
  deliveryOrders   DeliveryOrder[]     @relation("DeliveryOrderContact")
  invoices         Invoice[]           @relation("InvoiceContact")
  bills            Bill[]              @relation("BillContact")
  purchaseOrders   PurchaseOrder[]     @relation("PurchaseOrderContact")
  goodsReceived    GoodsReceivedNote[] @relation("GoodsReceivedContact")
  invoiceCreditNotes InvoiceCreditNote[] @relation("InvoiceCreditNoteContact")
  billCreditNotes    BillCreditNote[]    @relation("BillCreditNoteContact")

  @@unique([legalname, regNoType, regNo])
  @@index([contactType])
  @@index([parentId])
  @@index([userId])
  @@index([departmentId])
  @@map("contacts")
}

model ContactAddress {
  id           BigInt  @id @default(autoincrement())
  contactId    BigInt
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  countryCode  String
  purpose      String
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  contact       Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("ContactAddressCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?   @relation("ContactAddressUpdatedBy", fields: [updatedBy], references: [id])

  @@map("contact_address")
}

model ContactPerson {
  id        BigInt  @id @default(autoincrement())
  contactId BigInt
  name      String
  position  String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  contact       Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("ContactPersonCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?   @relation("ContactPersonUpdatedBy", fields: [updatedBy], references: [id])

  @@map("contact_persons")
}

model Country {
  id             BigInt @id @default(autoincrement())
  name           String
  code           String @db.Char(2)
  currencyCode   String
  currencyName   String
  currencySymbol String
  flag           String
  decimalPlaces  Int    @default(2)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  createdByUser User? @relation("CountryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("CountryUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([code])
  @@unique([currencyCode])
  @@index([name])
  @@map("countries")
}

model Department {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique
  name        String
  description String
  parentId    BigInt? @map("parent_id")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  parent        Department?           @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children      Department[]          @relation("DepartmentHierarchy")
  purchaseReqs  PurchaseRequisition[]
  createdByUser User?                 @relation("DepartmentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?                 @relation("DepartmentUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([parentId, name])
  @@map("departments")
}

model Device {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt
  deviceUUID String
  deviceName String
  deviceType String
  os         String
  osVersion  String
  appVersion String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("devices")
}

model EInvoiceType {
  id          BigInt @id @default(autoincrement())
  code        String
  description String

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  createdByUser User? @relation("EInvoiceTypeCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("EInvoiceTypeUpdatedBy", fields: [updatedBy], references: [id])

  @@map("einvoice_types")
}

model Invoice {
  id              BigInt                @id @default(autoincrement())
  number          String                @unique
  date            DateTime
  contactId       BigInt                @map("contact_id")
  currency        String
  subtotal        Decimal
  tax             Decimal               @default(0)
  discount        Decimal               @default(0)
  rounding        Decimal               @default(0)
  total           Decimal
  status          TransactionStatusType @default(DRAFT)
  notes           String?
  paymentTerms    String?
  dueDate         DateTime?
  canceledAt      DateTime?
  billingAddress  String?
  shippingAddress String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  contact           Contact            @relation("InvoiceContact", fields: [contactId], references: [id])
  invoiceLines      InvoiceLine[]
  invoicePayments   InvoicePayment[]
  invoiceRefunds    InvoiceRefund[]
  invoiceCreditNote InvoiceCreditNote?
  createdByUser     User?              @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?              @relation("InvoiceUpdatedBy", fields: [updatedBy], references: [id])

  @@map("invoices")
}

model InvoiceCreditNote {
  id         BigInt                @id @default(autoincrement())
  number     String                @unique
  date       DateTime
  invoiceId  BigInt?               @unique
