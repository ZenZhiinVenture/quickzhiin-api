{
  "name": "quickzhiin-api",
  "version": "1.0.0",
  "description": "QuickZhiin CRM & Accounting API",
  "main": "dist/index.js",
  "_moduleAliases": {
    "src": "src"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node -r tsconfig-paths/register --files src/server.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "keywords": [
    "authentication",
    "accounting",
    "content relationship management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@types/multer": "^2.1.0",
    "argon2": "^0.41.1",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.0",
    "module-alias": "^2.2.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "pg-promise": "^11.13.0",
    "prisma": "^7.6.0",
    "puppeteer": "^24.11.2",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/handlebars": "^4.0.40",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^20.5.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.14",
    "@types/qrcode": "^1.5.5",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.3"
  }
}
